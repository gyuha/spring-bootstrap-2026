<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  사용자 조회 매퍼 — 관리자 목록 페이징 (ADMIN-01, D-46).
  D-47/P7: JPA @SQLRestriction이 MyBatis에는 적용되지 않으므로 목록·카운트 SELECT 모두
  deleted_at IS NULL 수동 강제. 삭제 사용자 노출/삭제 포함 카운트 차단.
  컬럼을 record(AdminUserResponse) 컴포넌트명으로 alias해 생성자 기반 auto-mapping으로 매핑한다.
  role은 VARCHAR(enum STRING) 컬럼이라 그대로 select하면 Role enum으로 이름 기준 auto-map된다.
-->
<mapper namespace="com.example.bootstrap.domain.admin.mapper.UserQueryMapper">

    <select id="findPage" resultType="com.example.bootstrap.domain.admin.dto.AdminUserResponse">
        SELECT id, email, role, created_at AS "createdAt"
        FROM users
        WHERE deleted_at IS NULL
        ORDER BY created_at DESC
        OFFSET #{offset} LIMIT #{limit}
    </select>

    <select id="countActive" resultType="long">
        SELECT COUNT(*)
        FROM users
        WHERE deleted_at IS NULL
    </select>

</mapper>
